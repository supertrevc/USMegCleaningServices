---
import { content } from "../i18n/content";
import { ROUTES, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].cookie;
const cookiesHref = ROUTES.cookies[lang];

// Only auto-show the banner when there's actually analytics to gate. When no id is set
// there's nothing to consent to, so the banner stays hidden — but the component (and the
// footer "Cookie Preferences" link) remain wired, so it lights up automatically once an
// id is added to the env.
const analyticsEnabled = !!(
  import.meta.env.PUBLIC_GA_ID || import.meta.env.PUBLIC_CLARITY_ID
);
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-[var(--color-divider)] bg-white p-4 shadow-[0_-4px_20px_rgba(15,76,92,0.12)]"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
>
  <div class="container-page">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <p id="cookie-title" class="font-display font-semibold text-[var(--color-deep)]">
          {c.title}
        </p>
        <p id="cookie-desc" class="mt-1 text-sm text-[var(--color-muted)]">
          {c.body}
          <a class="underline" href={cookiesHref}>{content[lang].legal.cookies}</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="cookie-settings-toggle" class="btn btn-outline">
          {c.settings}
        </button>
        <button type="button" id="cookie-reject" class="btn btn-outline">
          {c.reject}
        </button>
        <button type="button" id="cookie-accept" class="btn btn-accent">
          {c.accept}
        </button>
      </div>
    </div>

    <fieldset id="cookie-settings" class="mt-4 hidden border-t border-[var(--color-divider)] pt-4">
      <legend class="sr-only">{c.settings}</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex items-start gap-3 rounded-lg border border-[var(--color-divider)] p-3">
          <input type="checkbox" checked disabled class="mt-1" />
          <span>
            <span class="block font-medium">{c.essential}</span>
            <span class="block text-sm text-[var(--color-muted)]">{c.essentialDesc}</span>
          </span>
        </label>
        <label class="flex items-start gap-3 rounded-lg border border-[var(--color-divider)] p-3">
          <input type="checkbox" id="cookie-analytics" class="mt-1" />
          <span>
            <span class="block font-medium">{c.analytics}</span>
            <span class="block text-sm text-[var(--color-muted)]">{c.analyticsDesc}</span>
          </span>
        </label>
      </div>
      <div class="mt-3">
        <button type="button" id="cookie-save" class="btn btn-accent">{c.save}</button>
      </div>
    </fieldset>
  </div>
</div>

<script is:inline define:vars={{ analyticsEnabled }}>
  (function () {
    const COOKIE = "usmeg_consent";
    const banner = document.getElementById("cookie-banner");
    if (!banner) return;
    const settings = document.getElementById("cookie-settings");
    const analyticsBox = document.getElementById("cookie-analytics");

    function read() {
      const m = document.cookie.match(/(?:^|;\s*)usmeg_consent=([^;]+)/);
      if (!m) return null;
      try {
        return JSON.parse(decodeURIComponent(m[1]));
      } catch {
        return null;
      }
    }
    function write(analytics) {
      const val = encodeURIComponent(
        JSON.stringify({ essential: true, analytics: !!analytics, ts: Date.now() })
      );
      // 180 days
      document.cookie =
        COOKIE + "=" + val + "; path=/; max-age=" + 60 * 60 * 24 * 180 + "; SameSite=Lax";
      window.dispatchEvent(new Event("usmeg:consent-updated"));
    }
    function hide() {
      banner.classList.add("hidden");
    }
    function show() {
      banner.classList.remove("hidden");
    }

    document.getElementById("cookie-accept").addEventListener("click", function () {
      write(true);
      hide();
    });
    document.getElementById("cookie-reject").addEventListener("click", function () {
      write(false);
      hide();
    });
    document
      .getElementById("cookie-settings-toggle")
      .addEventListener("click", function () {
        settings.classList.toggle("hidden");
      });
    document.getElementById("cookie-save").addEventListener("click", function () {
      write(analyticsBox.checked);
      hide();
    });

    // Re-open from the footer "Cookie Preferences" link.
    window.openCookiePrefs = function () {
      const existing = read();
      if (existing) analyticsBox.checked = !!existing.analytics;
      settings.classList.remove("hidden");
      show();
      banner.scrollIntoView({ behavior: "smooth", block: "end" });
    };

    // Auto-show only when analytics is configured; the footer link still works regardless.
    if (analyticsEnabled && !read()) show();
  })();
</script>
