---
/* ============================================================================
   BookingCalendar — interactive PLACEHOLDER (no backend).

   ──────────────────────────────────────────────────────────────────────────
   GOING LIVE WITH CAL.COM (single block change):
   Delete everything between  <!-- CAL.COM EMBED REGION START -->  and
   <!-- CAL.COM EMBED REGION END -->  (markup + the inline <script> live inside
   that region) and paste this in its place:

     <div id="cal-inline" style="width:100%;height:100%;min-height:640px;overflow:auto"></div>
     <script type="text/javascript">
       (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
       Cal("init", { origin: "https://cal.com" });
       Cal("inline", {
         elementOrSelector: "#cal-inline",
         calLink: "YOUR-CAL-USERNAME/cleaning", // <-- set the real Cal.com event link
         layout: "month_view",
       });
     </script>

   That replacement is the ONLY change required — nothing outside the region
   references the placeholder. (Cal.com handles real availability/timezones, so
   the DISABLED_WEEKDAYS / SLOT_START / SLOT_END knobs below become moot.)
   ========================================================================== */
import { content } from "../i18n/content";
import { business } from "../data/business";
import type { Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const b = t.booking;
const fm = t.contact.form; // reuse the exact quote-form labels + error strings
const serviceOpts = t.pricing.fields.serviceOptions;
const localeTag = lang === "es" ? "es-ES" : "en-US"; // for Intl date/time formatting
---

<section aria-labelledby="booking-heading">
  <p class="eyebrow">{b.eyebrow}</p>
  <h1 id="booking-heading" class="mt-2 text-[length:var(--text-h1)]">{b.heading}</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-muted)]">{b.intro}</p>

  <noscript>
    <p class="card mt-6 p-4 text-[var(--color-ink)]">
      {b.noscript}{" "}
      <a class="font-semibold text-[var(--color-brand)] underline" href={business.sms}>
        {business.phoneDisplay}
      </a>
    </p>
  </noscript>

  <!-- CAL.COM EMBED REGION START -->
  <!-- PLACEHOLDER booking UI (no network calls). To go live, replace this entire
       region with the Cal.com snippet documented at the top of this file. -->
  <div id="booking-app" class="mt-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
    <!-- Calendar column -->
    <div class="card p-5">
      <div class="flex items-center justify-between gap-2">
        <button
          type="button"
          id="cal-prev"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-[var(--color-deep)] hover:bg-[var(--color-surface)] disabled:cursor-not-allowed disabled:opacity-40"
          aria-label={b.prevMonth}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <h2 id="cal-month" class="font-display text-h4 text-[var(--color-deep)]" aria-live="polite"></h2>
        <button
          type="button"
          id="cal-next"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-[var(--color-deep)] hover:bg-[var(--color-surface)]"
          aria-label={b.nextMonth}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>

      <div
        id="cal-weekdays"
        class="mt-4 grid grid-cols-7 gap-1 text-center text-xs font-medium text-[var(--color-muted)]"
        aria-hidden="true"
      ></div>
      <div
        id="cal-grid"
        class="mt-1 grid grid-cols-7 gap-1"
        role="grid"
        aria-label={b.selectDate}
      ></div>
    </div>

    <!-- Slots + details column -->
    <div class="card flex flex-col p-5">
      <h2 class="text-h4">{b.selectTime}</h2>
      <p id="slots-hint" class="mt-2 text-sm text-[var(--color-muted)]">{b.chooseDateHint}</p>
      <div
        id="slots"
        class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3"
        role="group"
        aria-label={b.selectTime}
        aria-live="polite"
      ></div>

      <!-- Details form (revealed after a slot is picked) -->
      <form id="booking-form" class="mt-6 grid gap-4" novalidate hidden aria-live="polite">
        <h3 class="text-h4">{b.yourDetails}</h3>
        <!-- Honeypot (parity with the quote form) -->
        <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div>
          <label class="mb-1 block text-sm font-medium" for="bk-name">{fm.name} *</label>
          <input id="bk-name" name="name" required aria-describedby="bk-name-err" class="w-full rounded-lg border border-[var(--color-divider)] px-3 py-2.5" />
          <p id="bk-name-err" class="field-err mt-1 hidden text-sm text-red-700"></p>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium" for="bk-phone">{fm.phone} *</label>
          <input id="bk-phone" name="phone" required inputmode="tel" aria-describedby="bk-phone-err" class="w-full rounded-lg border border-[var(--color-divider)] px-3 py-2.5" />
          <p id="bk-phone-err" class="field-err mt-1 hidden text-sm text-red-700"></p>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium" for="bk-email">{fm.emailOptional}</label>
          <input id="bk-email" name="email" type="email" aria-describedby="bk-email-err" class="w-full rounded-lg border border-[var(--color-divider)] px-3 py-2.5" />
          <p id="bk-email-err" class="field-err mt-1 hidden text-sm text-red-700"></p>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium" for="bk-service">{fm.service}</label>
          <select id="bk-service" name="service" class="w-full rounded-lg border border-[var(--color-divider)] bg-white px-3 py-2.5">
            {serviceOpts.map((o) => <option value={o.label}>{o.label}</option>)}
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium" for="bk-message">{fm.message}</label>
          <textarea id="bk-message" name="message" rows="3" class="w-full rounded-lg border border-[var(--color-divider)] px-3 py-2.5"></textarea>
        </div>
        <button type="submit" class="btn btn-accent">{b.confirm}</button>
      </form>
    </div>
  </div>

  <!-- Confirmation (shown after Confirm booking; static, no network) -->
  <div id="booking-confirmation" class="card mt-8 p-6" role="status" aria-live="polite" hidden>
    <div class="flex items-start gap-3">
      <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-brand)] text-white" aria-hidden="true">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
      </span>
      <div>
        <h2 id="booking-confirm-heading" tabindex="-1" class="text-h4">{b.requested}</h2>
        <p class="mt-1 text-[var(--color-muted)]">{b.willText}</p>
      </div>
    </div>
    <dl class="mt-5 grid gap-2 border-t border-[var(--color-divider)] pt-5 text-sm">
      <div class="flex gap-2">
        <dt class="w-24 font-semibold text-[var(--color-deep)]">{b.summaryDate}</dt>
        <dd id="sum-date" class="text-[var(--color-ink)]"></dd>
      </div>
      <div class="flex gap-2">
        <dt class="w-24 font-semibold text-[var(--color-deep)]">{b.summaryTime}</dt>
        <dd id="sum-time" class="text-[var(--color-ink)]"></dd>
      </div>
      <div class="flex gap-2">
        <dt class="w-24 font-semibold text-[var(--color-deep)]">{b.summaryService}</dt>
        <dd id="sum-service" class="text-[var(--color-ink)]"></dd>
      </div>
    </dl>
    <div class="mt-6 flex flex-wrap gap-3">
      <button type="button" id="booking-reset" class="btn btn-outline">{b.chooseAnother}</button>
      <a href={business.sms} class="btn btn-accent" data-track="sms_click">{t.cta.textUs}</a>
    </div>
  </div>

  <script
    is:inline
    define:vars={{
      locale: localeTag,
      disabledWord: b.unavailable,
      errRequired: fm.errorRequired,
      errEmail: fm.errorEmail,
      selectTimeLabel: b.selectTime,
    }}
  >
    (function () {
      // ---- Availability knobs (Cal.com enforces the real rules after swap) ----
      const DISABLED_WEEKDAYS = []; // 0=Sun … 6=Sat. Empty = every day bookable.
      const SLOT_START = 8; // first slot hour (24h)
      const SLOT_END = 16; // last slot hour (24h), inclusive — hourly

      const app = document.getElementById("booking-app");
      if (!app) return;

      const grid = document.getElementById("cal-grid");
      const weekdaysEl = document.getElementById("cal-weekdays");
      const monthEl = document.getElementById("cal-month");
      const prevBtn = document.getElementById("cal-prev");
      const nextBtn = document.getElementById("cal-next");
      const slotsEl = document.getElementById("slots");
      const slotsHint = document.getElementById("slots-hint");
      const form = document.getElementById("booking-form");
      const confirmation = document.getElementById("booking-confirmation");

      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const dayFmt = new Intl.DateTimeFormat(locale, {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      });
      const monthFmt = new Intl.DateTimeFormat(locale, { month: "long", year: "numeric" });
      const wdFmt = new Intl.DateTimeFormat(locale, { weekday: "short" });
      const timeFmt = new Intl.DateTimeFormat(locale, { hour: "numeric", minute: "2-digit" });

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      let view = new Date(today.getFullYear(), today.getMonth(), 1);
      let selectedDate = null; // Date at midnight
      let selectedSlot = null; // { hour, label }

      // Weekday header (Sun→Sat), localized.
      (function renderWeekdays() {
        let html = "";
        for (let i = 0; i < 7; i++) {
          const d = new Date(2024, 8, 1 + i); // 2024-09-01 was a Sunday
          html += "<span>" + wdFmt.format(d) + "</span>";
        }
        weekdaysEl.innerHTML = html;
      })();

      function sameDay(a, c) {
        return a && c && a.getTime() === c.getTime();
      }

      function renderCalendar() {
        monthEl.textContent = monthFmt.format(view);
        // Disable "prev" when viewing the current month (can't book the past).
        const atCurrentMonth =
          view.getFullYear() === today.getFullYear() &&
          view.getMonth() === today.getMonth();
        prevBtn.disabled = atCurrentMonth;

        const firstDow = new Date(view.getFullYear(), view.getMonth(), 1).getDay();
        const daysInMonth = new Date(
          view.getFullYear(),
          view.getMonth() + 1,
          0
        ).getDate();

        grid.innerHTML = "";
        // Leading empty cells
        for (let i = 0; i < firstDow; i++) {
          const cell = document.createElement("div");
          cell.setAttribute("aria-hidden", "true");
          grid.appendChild(cell);
        }
        for (let day = 1; day <= daysInMonth; day++) {
          const date = new Date(view.getFullYear(), view.getMonth(), day);
          date.setHours(0, 0, 0, 0);
          const isPast = date < today;
          const isDisabledDow = DISABLED_WEEKDAYS.indexOf(date.getDay()) !== -1;
          const disabled = isPast || isDisabledDow;
          const isSel = sameDay(date, selectedDate);

          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = String(day);
          btn.className =
            "flex h-11 w-full items-center justify-center rounded-lg border text-sm transition-colors " +
            (isSel
              ? "border-transparent bg-[var(--color-deep)] font-semibold text-white"
              : disabled
                ? "cursor-not-allowed border-transparent text-[var(--color-muted)] opacity-40"
                : "border-[var(--color-divider)] text-[var(--color-ink)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]");
          if (disabled) {
            btn.disabled = true;
            btn.setAttribute(
              "aria-label",
              dayFmt.format(date) + " — " + disabledWord
            );
          } else {
            btn.setAttribute("aria-label", dayFmt.format(date));
            btn.setAttribute("aria-pressed", isSel ? "true" : "false");
            btn.addEventListener("click", function () {
              selectedDate = date;
              selectedSlot = null;
              renderCalendar();
              renderSlots();
            });
          }
          grid.appendChild(btn);
        }
      }

      function renderSlots() {
        form.hidden = true;
        slotsEl.innerHTML = "";
        if (!selectedDate) {
          slotsHint.hidden = false;
          return;
        }
        slotsHint.hidden = true;
        for (let h = SLOT_START; h <= SLOT_END; h++) {
          const t = new Date(selectedDate);
          t.setHours(h, 0, 0, 0);
          const label = timeFmt.format(t);
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = label;
          const isSel = selectedSlot && selectedSlot.hour === h;
          btn.className =
            "min-h-[44px] rounded-lg border px-2 py-2 text-sm transition-colors " +
            (isSel
              ? "border-transparent bg-[var(--color-deep)] font-semibold text-white"
              : "border-[var(--color-divider)] text-[var(--color-ink)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)]");
          btn.setAttribute("aria-pressed", isSel ? "true" : "false");
          btn.addEventListener("click", function () {
            selectedSlot = { hour: h, label: label };
            renderSlots();
            form.hidden = false;
            const nameInput = document.getElementById("bk-name");
            if (nameInput) nameInput.focus();
          });
          slotsEl.appendChild(btn);
        }
      }

      // ---- Validation (parity with the quote form) ----
      function setErr(name, message) {
        const input = form.querySelector('[name="' + name + '"]');
        if (!input) return;
        const err = document.getElementById(input.id + "-err");
        if (err) {
          err.textContent = message;
          err.classList.toggle("hidden", !message);
        }
        if (message) input.setAttribute("aria-invalid", "true");
        else input.removeAttribute("aria-invalid");
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form).entries());
        if (data.company) return; // honeypot

        let ok = true;
        setErr("name", "");
        setErr("phone", "");
        setErr("email", "");
        if (!data.name) {
          setErr("name", errRequired);
          ok = false;
        }
        if (!data.phone) {
          setErr("phone", errRequired);
          ok = false;
        }
        if (data.email && !EMAIL_RE.test(data.email)) {
          setErr("email", errEmail);
          ok = false;
        }
        if (!ok) {
          const firstErr = form.querySelector('[aria-invalid="true"]');
          if (firstErr) firstErr.focus();
          return;
        }

        // Fill the static confirmation summary (no network — placeholder).
        document.getElementById("sum-date").textContent = selectedDate
          ? dayFmt.format(selectedDate)
          : "";
        document.getElementById("sum-time").textContent = selectedSlot
          ? selectedSlot.label
          : "";
        document.getElementById("sum-service").textContent =
          form.querySelector("#bk-service").value;

        app.hidden = true;
        confirmation.hidden = false;
        const ch = document.getElementById("booking-confirm-heading");
        if (ch) ch.focus(); // move focus to the confirmation for screen-reader users
        confirmation.scrollIntoView({ behavior: "smooth", block: "center" });
        if (window.trackEvent)
          window.trackEvent("booking_requested", {
            service: form.querySelector("#bk-service").value,
          });
      });

      document.getElementById("booking-reset").addEventListener("click", function () {
        confirmation.hidden = true;
        app.hidden = false;
        selectedSlot = null;
        form.reset();
        renderSlots();
        app.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      prevBtn.addEventListener("click", function () {
        view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
        renderCalendar();
      });
      nextBtn.addEventListener("click", function () {
        view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
        renderCalendar();
      });

      renderCalendar();
      renderSlots();
    })();
  </script>
  <!-- CAL.COM EMBED REGION END -->
</section>
