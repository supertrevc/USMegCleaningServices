---
import PageLayout from "../../../layouts/PageLayout.astro";
import LegalArticle from "../../../components/LegalArticle.astro";
import { legal, effectiveDate } from "../../../data/legal";

const lang = "es" as const;
const doc = legal[lang]["terms"];
---

<PageLayout lang={lang} pageKey="terms" title={doc.title} description={doc.intro}>
  <LegalArticle lang={lang} doc={doc} updated={effectiveDate(lang)} />
</PageLayout>
