# Copy this file to `.env` for local dev, and set the same keys in the Vercel
# project's Environment Variables for production. All keys are optional — the site
# builds and runs without them; each feature simply stays dormant until its key is set.

# Google Analytics 4 Measurement ID. Empty = GA not loaded, cookie banner stays hidden.
PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity project ID. Empty = Clarity not loaded.
PUBLIC_CLARITY_ID=abcdefghij

# Resend API key for the contact/quote form (https://resend.com/api-keys).
# Empty = form submissions are logged but NOT emailed (the form still returns success).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender shown on form emails. Default is Resend's shared test sender (no domain
# verification needed). Switch to noreply@megcleaning.com once that domain is verified.
FROM_EMAIL=US Meg Cleaning Services <onboarding@resend.dev>

# Inbox that receives form submissions.
TO_EMAIL=usmegcleaningservices@gmail.com
